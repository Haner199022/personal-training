.hero { display: flex; flex-direction: column; align-items: center; padding: 32rpx 0 40rpx; }
.avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; margin-bottom: 24rpx;
  background: var(--c-brand-soft);
  box-shadow: 0 0 32rpx rgba(168,85,247,0.4);
}
.name { margin-bottom: 16rpx; }
.cert { background: var(--c-brand-soft); color: var(--c-brand); }

.bio { margin: 16rpx 0 24rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { background: var(--c-elev2); color: var(--c-text); }

.status { display: flex; align-items: center; gap: 12rpx; margin: 16rpx 0 8rpx; }
.status-text { font-size: 30rpx; font-weight: 600; }
.serving-for { margin-top: 8rpx; }

.enter { width: 100%; margin-top: 8rpx; }
.foot { text-align: center; margin-top: 20rpx; }
