.title { margin-bottom: 24rpx; }

/* User row */
.user { display: flex; align-items: center; gap: 24rpx; background: linear-gradient(135deg, var(--c-elev), var(--c-elev2)); }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; background: var(--c-brand-soft);
  box-shadow: 0 0 24rpx rgba(168,85,247,0.4);
}
.u-name { font-size: 36rpx; font-weight: 700; }

/* Section labels */
.menu-label { margin: 24rpx 0 16rpx; }

/* Menu rows */
.row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; }
.row-l { font-size: 30rpx; font-weight: 600; }
.row-r { display: flex; align-items: center; gap: 12rpx; }
.r-val { font-size: 26rpx; color: var(--c-mute); }
.r-val.ok { color: var(--c-green); }
.r-val.warn { color: var(--c-yellow); }
.arrow { font-size: 40rpx; color: var(--c-mute); line-height: 1; }

.foot { text-align: center; margin-top: 16rpx; }
