.code-input { margin-top: 20rpx; background: var(--c-elev2); border-radius: 16rpx; padding: 24rpx; font-size: 40rpx;
  letter-spacing: 8rpx; text-align: center; color: var(--c-brand); font-weight: 700; }
.scan { text-align: center; }
.cam { width: 160rpx; height: 160rpx; margin: 24rpx auto 16rpx; border: 2rpx dashed var(--c-border); border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; font-size: 56rpx; }
