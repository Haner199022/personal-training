.top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.bell { position: relative; font-size: 40rpx; }
.badge { position: absolute; top: -8rpx; right: -12rpx; background: var(--c-red); color: #fff; font-size: 18rpx; border-radius: 20rpx; padding: 0 8rpx; }
.today { background: linear-gradient(135deg, var(--c-elev), var(--c-elev2)); }
.tt { margin: 12rpx 0 8rpx; } .start { width: 100%; margin-top: 24rpx; }
.rc-h { font-weight: 600; margin-bottom: 6rpx; }
.join-tip { border-left: 4rpx solid var(--c-yellow); }
.small { display: inline-block; margin-top: 16rpx; padding: 8rpx 24rpx; font-size: 24rpx; }
