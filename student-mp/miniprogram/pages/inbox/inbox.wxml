<view class="container">
  <view class="h2 top">消息</view>

  <view wx:for="{{items}}" wx:key="id" class="card msg {{item.read ? 'is-read' : ''}}"
        data-id="{{item.id}}" data-link="{{item.link}}" bindtap="tapItem">
    <view class="msg-h">
      <text wx:if="{{!item.read}}" class="dot">●</text>
      <text class="title">{{item.title}}</text>
      <text wx:if="{{item.read}}" class="read-tag">已读</text>
    </view>
    <view class="caption sub">{{item.ref_title}}<text wx:if="{{item.ref_title}}"> · </text>{{item.time}}</view>
  </view>

  <view wx:if="{{items.length === 0}}" class="empty caption">暂无消息</view>
</view>
