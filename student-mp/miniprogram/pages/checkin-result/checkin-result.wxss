.done-head { text-align: center; padding: 40rpx 0 16rpx; }
.done-emoji { font-size: 96rpx; line-height: 1; margin-bottom: 16rpx; }
.done-title { margin-bottom: 12rpx; }
.done-sub { display: block; }

.comment-body { margin: 16rpx 0 12rpx; }
.sign { display: block; text-align: right; color: var(--c-brand); }
.pending-title { margin: 16rpx 0 8rpx; }

.sub-card { background: var(--c-elev); opacity: 0.92; }
.sub-card .h3 { margin-bottom: 6rpx; }
.sub-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.sub-btn { flex: 1; font-size: 26rpx; padding: 12rpx 0; line-height: 1.6; }

.home-btn { width: 100%; margin-top: 16rpx; }
