.login { min-height: 100vh; padding: 120rpx 56rpx; display: flex; flex-direction: column; align-items: center;
  background: radial-gradient(circle at 50% 0%, var(--c-brand-soft) 0%, transparent 600rpx); }
.brand { text-align: center; margin-bottom: 24rpx; }
.mark { width: 96rpx; height: 96rpx; margin: 0 auto 20rpx; border-radius: 24rpx; background: var(--c-brand); color: #fff;
  font-weight: 800; font-size: 40rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 32rpx rgba(168,85,247,0.6); }
.title { font-size: 40rpx; font-weight: 800; } .sub { text-align: center; margin: 16rpx 0 80rpx; }
.go { width: 100%; margin-bottom: 32rpx; } .agree { text-align: center; margin-top: 8rpx; }
