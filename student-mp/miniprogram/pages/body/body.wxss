/* body — 我的趋势 (S-6) */
.top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.addbtn { display: inline-block; padding: 10rpx 24rpx; font-size: 24rpx; line-height: 1.4; }

/* Underline tabs */
.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid var(--c-border); }
.tab { padding: 16rpx 8rpx; font-size: 28rpx; color: var(--c-mute); font-weight: 600; position: relative; }
.tab.on { color: var(--c-text); }
.tab.on::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: -1rpx; height: 4rpx;
  background: var(--c-brand); border-radius: 4rpx; box-shadow: 0 0 12rpx rgba(168,85,247,0.6);
}

/* CSS bar chart */
.chart {
  display: flex; align-items: flex-end; justify-content: space-around;
  height: 280rpx; margin: 28rpx 0 8rpx; gap: 10rpx;
}
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar-val { font-size: 18rpx; color: var(--c-mute); margin-bottom: 6rpx; white-space: nowrap; }
.bar {
  width: 70%; max-width: 48rpx; min-height: 8rpx; border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, var(--c-brand), var(--c-brand-soft));
  box-shadow: 0 0 16rpx rgba(168,85,247,0.4);
}
.bar-x { font-size: 18rpx; color: var(--c-mute); margin-top: 10rpx; white-space: nowrap; }

/* Summary row */
.sumrow { display: flex; justify-content: space-between; }
.sum-item { flex: 1; text-align: center; }
.sum-v { font-size: 32rpx; font-weight: 700; margin-top: 6rpx; }

/* Empty state */
.empty { text-align: center; padding: 56rpx 0 40rpx; }
.empty-emoji { font-size: 64rpx; margin-bottom: 16rpx; }

/* Calendar */
.cal-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.cal-week { display: flex; }
.cal-wh { flex: 1; text-align: center; font-size: 22rpx; color: var(--c-mute); font-weight: 600; }
.cal-grid { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.cal-cell {
  width: 14.28%; box-sizing: border-box; height: 88rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.cal-day { font-size: 22rpx; color: var(--c-mute); }
.cal-sym { font-size: 28rpx; line-height: 1.2; margin-top: 2rpx; color: var(--c-border); }
.cal-cell.done .cal-sym { color: var(--c-green); }
.cal-cell.missed .cal-sym { color: var(--c-yellow); }
.cal-cell.done .cal-day, .cal-cell.missed .cal-day { color: var(--c-text); }

/* Legend */
.legend { display: flex; gap: 28rpx; }
.lg { font-size: 22rpx; color: var(--c-mute); }

/* Photo compare entry */
.photo-entry { width: 100%; margin-top: 8rpx; }
