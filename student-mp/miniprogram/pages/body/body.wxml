<view class="container">
  <!-- Header -->
  <view class="top">
    <view class="h2">📈 我的趋势</view>
    <button class="btn-ghost addbtn" bindtap="toMetric">+ 录体脂</button>
  </view>

  <!-- Underline tabs -->
  <view class="tabs">
    <view class="tab {{tab==='weight'?'on':''}}" data-tab="weight" bindtap="switchTab">体重</view>
    <view class="tab {{tab==='fat'?'on':''}}" data-tab="fat" bindtap="switchTab">体脂</view>
    <view class="tab {{tab==='cal'?'on':''}}" data-tab="cal" bindtap="switchTab">日历</view>
  </view>

  <!-- Weight tab -->
  <block wx:if="{{tab==='weight'}}">
    <view class="card">
      <view class="micro">体重趋势</view>
      <block wx:if="{{!metricsEmpty && weightBars.length>0}}">
        <view class="chart">
          <view wx:for="{{weightBars}}" wx:key="label" class="bar-col">
            <view class="bar-val">{{item.text}}</view>
            <view class="bar" style="height:{{item.heightPct}}%"></view>
            <view class="bar-x">{{item.label}}</view>
          </view>
        </view>
        <view class="divider"></view>
        <view class="sumrow">
          <view class="sum-item"><view class="caption">起始</view><view class="sum-v">{{weightSummary.start}}</view></view>
          <view class="sum-item"><view class="caption">当前</view><view class="sum-v">{{weightSummary.current}}</view></view>
          <view class="sum-item"><view class="caption">变化</view><view class="sum-v {{weightSummary.deltaState==='down'?'dot-green':''}}">{{weightSummary.delta}}</view></view>
          <view class="sum-item"><view class="caption">打卡</view><view class="sum-v">{{weightSummary.count}}</view></view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="empty-emoji">⚖️</view>
        <view class="caption">还没有体脂记录，点右上角录入</view>
      </view>
    </view>
  </block>

  <!-- Fat tab -->
  <block wx:if="{{tab==='fat'}}">
    <view class="card">
      <view class="micro">体脂率趋势</view>
      <block wx:if="{{!metricsEmpty && fatBars.length>0}}">
        <view class="chart">
          <view wx:for="{{fatBars}}" wx:key="label" class="bar-col">
            <view class="bar-val">{{item.text}}</view>
            <view class="bar" style="height:{{item.heightPct}}%"></view>
            <view class="bar-x">{{item.label}}</view>
          </view>
        </view>
        <view class="divider"></view>
        <view class="sumrow">
          <view class="sum-item"><view class="caption">起始</view><view class="sum-v">{{fatSummary.start}}</view></view>
          <view class="sum-item"><view class="caption">当前</view><view class="sum-v">{{fatSummary.current}}</view></view>
          <view class="sum-item"><view class="caption">变化</view><view class="sum-v {{fatSummary.deltaState==='down'?'dot-green':''}}">{{fatSummary.delta}}</view></view>
          <view class="sum-item"><view class="caption">打卡</view><view class="sum-v">{{fatSummary.count}}</view></view>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="empty-emoji">📊</view>
        <view class="caption">还没有体脂记录，点右上角录入</view>
      </view>
    </view>
  </block>

  <!-- Calendar tab -->
  <block wx:if="{{tab==='cal'}}">
    <view class="card">
      <view class="cal-top">
        <view class="micro">{{monthLabel || '本月打卡'}}</view>
        <view class="chip">本月完成 {{calDone}}/{{calPlanned}}</view>
      </view>
      <block wx:if="{{!calEmpty}}">
        <view class="cal-week">
          <view wx:for="{{weekHeaders}}" wx:key="*this" class="cal-wh">{{item}}</view>
        </view>
        <view class="cal-grid">
          <view wx:for="{{calCells}}" wx:key="index" class="cal-cell {{item.state}}">
            <text wx:if="{{item.day>0}}" class="cal-day">{{item.day}}</text>
            <text wx:if="{{item.day>0}}" class="cal-sym">{{item.symbol}}</text>
          </view>
        </view>
        <view class="divider"></view>
        <view class="legend">
          <text class="lg dot-green">● 已打卡</text>
          <text class="lg dot-yellow">○ 漏练</text>
          <text class="lg">· 无课</text>
        </view>
      </block>
      <view wx:else class="empty">
        <view class="empty-emoji">🗓️</view>
        <view class="caption">还没有打卡记录，开始今天的训练吧</view>
      </view>
    </view>
  </block>

  <!-- Photo compare entry -->
  <button class="btn-ghost photo-entry" bindtap="toPhotoCompare">体脂照对比 →</button>
</view>
