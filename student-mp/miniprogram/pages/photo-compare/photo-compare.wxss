/* 姿态切换 */
.poses { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.pose-chip { padding: 12rpx 32rpx; font-size: 26rpx; border: 1rpx solid var(--c-border); }
.pose-on {
  background: var(--c-brand-soft);
  color: var(--c-brand);
  border-color: var(--c-brand);
  box-shadow: 0 0 20rpx rgba(168,85,247,0.4);
}

/* 对比网格 */
.grid { display: flex; gap: 20rpx; }
.col { flex: 1; padding: 20rpx; margin-bottom: 24rpx; }
.frame {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--c-elev2);
  border: 1rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.shot { width: 100%; height: 100%; }
.ph { color: var(--c-mute); font-size: 24rpx; }
.date-label { text-align: center; font-size: 26rpx; font-weight: 600; margin: 16rpx 0 12rpx; }
.picker {
  text-align: center;
  font-size: 24rpx;
  color: var(--c-mute);
  background: var(--c-elev2);
  border-radius: 12rpx;
  padding: 10rpx 0;
}

/* ◀▶ 步进 */
.steppers { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.step-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--c-elev);
  border: 1rpx solid var(--c-border);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}
.arrows { display: flex; gap: 16rpx; }
.arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--c-brand);
  background: var(--c-elev2);
  border-radius: 12rpx;
}

/* 汇总 */
.summary { text-align: center; }
.sum-line { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: 20rpx 0 12rpx; }
.sum-v { font-size: 56rpx; font-weight: 800; letter-spacing: -1rpx; }
.sum-arrow { font-size: 36rpx; color: var(--c-mute); }
.sum-to { color: var(--c-brand); }

/* 空态 */
.empty { text-align: center; padding: 56rpx 32rpx; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty .btn-ghost { display: inline-block; padding: 16rpx 48rpx; }

/* 隐私说明 */
.privacy { display: block; text-align: center; margin-top: 24rpx; line-height: 1.6; }
