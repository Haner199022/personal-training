# === production env — copy to .env.prod, fill CHANGE_ME, never commit ===
# APP_ENV must be non-dev so config.py fail-fast enforces strong secrets + non-sqlite DB.
APP_ENV=prod
API_V1_PREFIX=/api/v1

# --- Postgres container creds (consumed by the `db` service in docker-compose.yml) ---
# Keep these in sync with DATABASE_URL below.
PG_DB=personal_training
PG_USER=app_user
PG_PASSWORD=CHANGE_ME

# --- DATABASE_URL: points at the `db` compose service (host = db), async psycopg3 driver ---
# Must match PG_USER / PG_PASSWORD / PG_DB above.
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@db:5432/personal_training

# --- Redis: points at the `redis` compose service (host = redis) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080

# --- 微信小程序 (code2session) ---
WX_APP_ID=CHANGE_ME
WX_APP_SECRET=CHANGE_ME

# --- 教练企微 webhook 加密 key (fernet, base64 32B) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPT_KEY=CHANGE_ME

# --- 腾讯云 COS (体脂照, 上海/广州, 禁跨境) ---
COS_REGION=ap-shanghai
COS_BUCKET=CHANGE_ME
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME

# --- Sentry (可选, 留空则关闭) ---
SENTRY_DSN=
