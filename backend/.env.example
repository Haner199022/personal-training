# === backend env (copy to .env, never commit) ===
APP_ENV=dev
API_V1_PREFIX=/api/v1

# PostgreSQL (async psycopg)
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@localhost:5432/personal_training

# Redis (MVP 可空，单机走 asyncio.Queue)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=CHANGE_ME_long_random_string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080

# 微信小程序 (code2session)
WX_APP_ID=
WX_APP_SECRET=

# 教练企微 webhook 加密 key (fernet, base64 32B). 生成:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WEBHOOK_ENCRYPT_KEY=

# 腾讯云 COS (体脂照, 上海/广州, 禁跨境)
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=

# Sentry (可选)
SENTRY_DSN=
